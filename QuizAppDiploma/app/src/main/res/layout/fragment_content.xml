<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable
            name="contentmodel"
            type="com.example.quizappdiploma.fragments.viewmodels.LectureViewModel" />
    </data>

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/md_background">

        <!-- Scrollable content -->
        <ScrollView
            android:id="@+id/scrollViewContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/lecture_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="100dp">

                <!-- Hero image area -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="240dp">

                    <ImageView
                        android:id="@+id/lectureImageView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/lightbulb" />

                    <!-- Gradient overlay on image -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_navy_gradient"
                        android:alpha="0.5" />

                    <ProgressBar
                        android:id="@+id/imageProgressBar"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_gravity="center"
                        android:indeterminate="true"
                        android:visibility="gone" />

                </FrameLayout>

                <!-- Title card -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginTop="-24dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="6dp"
                    app:cardBackgroundColor="@color/md_surface">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="LECTURE"
                            android:textColor="@color/md_primary"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.1" />

                        <TextView
                            android:id="@+id/lectureTitleTxt"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Lecture Title"
                            android:textColor="@color/md_on_surface"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:lineSpacingMultiplier="1.2" />

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Content card -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginTop="12dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="@color/md_surface">

                    <TextView
                        android:id="@+id/lectureDescriptionTxt"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="20dp"
                        android:text="Lecture description goes here..."
                        android:textColor="@color/md_on_surface"
                        android:textSize="16sp"
                        android:lineSpacingMultiplier="1.6" />

                </androidx.cardview.widget.CardView>

            </LinearLayout>
        </ScrollView>

        <!-- Sticky bottom bar with navigation buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_gravity="bottom"
            android:background="@color/md_surface"
            android:elevation="8dp"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:gravity="center_vertical"
            android:weightSum="3">

            <!-- Previous -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/lecturePreviousBtn"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="Previous"
                app:cornerRadius="10dp"
                app:icon="@drawable/baseline_arrow_back_ios_24"
                app:iconSize="16dp" />

            <!-- Start Quiz -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/lectureStartQuizBtn"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:text="Quiz"
                android:textSize="13sp"
                android:visibility="gone"
                app:backgroundTint="@color/app_accent_green"
                app:cornerRadius="10dp"
                app:icon="@drawable/baseline_play_arrow_24"
                app:iconSize="16dp" />

            <!-- Next -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/lectureNextBtn"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="Next"
                app:cornerRadius="10dp"
                app:backgroundTint="@color/md_primary"
                app:iconGravity="end"
                app:icon="@drawable/baseline_arrow_forward_ios_24"
                app:iconSize="16dp" />

        </LinearLayout>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</layout>
