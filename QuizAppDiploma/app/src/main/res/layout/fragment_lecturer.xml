<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/md_background">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="48dp"
        android:paddingBottom="16dp"
        android:background="@drawable/bg_primary_gradient">

        <!-- Avatar -->
        <FrameLayout
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_avatar_circle">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="L"
                android:textColor="@color/md_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

        </FrameLayout>

        <!-- Name / email -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:id="@+id/nameTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lecturer"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/emailTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="lecturer@example.com"
                android:textColor="#CCFFFFFF"
                android:textSize="13sp" />

        </LinearLayout>

        <!-- Logout -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/logoutButton"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Logout"
            android:textSize="12sp"
            app:cornerRadius="10dp" />

    </LinearLayout>

    <!-- Quick nav button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="4dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/coursesButton"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="Courses"
            android:textSize="13sp"
            app:cornerRadius="10dp"
            app:icon="@drawable/baseline_book_24"
            app:iconSize="16dp" />

    </LinearLayout>

    <!-- Entity selector -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="8dp"
        app:cardCornerRadius="14dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="@color/md_surface">

        <GridLayout
            android:id="@+id/radioGridLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="3"
            android:rowCount="1"
            android:padding="8dp">

            <RadioButton
                android:id="@+id/coursesRadioButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_gravity="fill"
                android:gravity="center"
                android:padding="8dp"
                android:text="Courses"
                android:textSize="12sp"
                android:textColor="@color/md_on_surface"
                android:buttonTint="@color/md_primary" />

            <RadioButton
                android:id="@+id/lecturesRadioButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_gravity="fill"
                android:gravity="center"
                android:padding="8dp"
                android:text="Lectures"
                android:textSize="12sp"
                android:textColor="@color/md_on_surface"
                android:buttonTint="@color/md_primary" />

            <RadioButton
                android:id="@+id/questionsRadioButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_gravity="fill"
                android:gravity="center"
                android:padding="8dp"
                android:text="Questions"
                android:textSize="12sp"
                android:textColor="@color/md_on_surface"
                android:buttonTint="@color/md_primary" />

        </GridLayout>
    </androidx.cardview.widget.CardView>

    <!-- Fragment list container -->
    <FrameLayout
        android:id="@+id/fragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp" />

    <!-- Action buttons -->
    <LinearLayout
        android:id="@+id/buttonLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="16dp"
        android:weightSum="3"
        android:background="@color/md_surface"
        android:elevation="4dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/addButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="Add"
            android:textSize="13sp"
            app:cornerRadius="10dp"
            app:backgroundTint="@color/app_accent_green"
            app:icon="@drawable/baseline_add_24"
            app:iconSize="16dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/updateButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:text="Update"
            android:textSize="13sp"
            app:cornerRadius="10dp"
            app:backgroundTint="@color/md_primary"
            app:icon="@drawable/baseline_edit_24"
            app:iconSize="16dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/removeButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="Remove"
            android:textSize="13sp"
            app:cornerRadius="10dp"
            app:backgroundTint="@color/app_accent_red"
            app:icon="@drawable/baseline_delete_24"
            app:iconSize="16dp" />

    </LinearLayout>

</LinearLayout>
